report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


# ---------------------------------------------------------------------------
# Generated agent integrations
#
# Custom skills source of truth: /skills/
# OpenSpec source of truth: /openspec/ + OpenSpec CLI
#
# The copies under each agent directory are generated and must not be tracked.
# ---------------------------------------------------------------------------

/.agents/skills/*/
/.agents/skills/.openspec-target

/.claude/skills/*/
/.claude/commands/opsx/

/.kiro/skills/*/
/.kiro/prompts/

/.opencode/skills/*/
/.opencode/commands/